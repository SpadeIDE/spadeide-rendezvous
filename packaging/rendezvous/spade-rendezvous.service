[Unit]
Description=SpadeIDE Rendezvous (introducer + blind relay)
Documentation=https://github.com/spadeide
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spade-rv
Group=spade-rv
EnvironmentFile=-/etc/spade-rendezvous/env
ExecStart=/usr/local/bin/spade-rendezvous serve
Restart=on-failure
RestartSec=3

# ACME cache / state — only writable path under ProtectSystem=strict.
StateDirectory=spade-rendezvous
ConfigurationDirectory=spade-rendezvous
ReadWritePaths=/var/lib/spade-rendezvous

# Bind 443 without being root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening — requirements from docs/plans/remote-access-implementation.md §6.8.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

# Every online agent holds a socket; default 1024 is too low.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
