# Example environment for spade-rendezvous.
# install.sh copies this to /etc/spade-rendezvous/env when missing.
# Ticket signing key is generated in memory and never written to disk.

SPADE_RV_DOMAIN=rendezvous.example.com
SPADE_RV_ACME_EMAIL=ops@example.com
SPADE_RV_LISTEN=:443
SPADE_RV_UDP_LISTEN=:443
SPADE_RV_METRICS_LISTEN=127.0.0.1:9090
SPADE_RV_ACME_CACHE=/var/lib/spade-rendezvous/acme

# Session / abuse caps (finite defaults — raise only if you mean to).
# 0 for SESSION_MAX_BYTES = unlimited (not recommended on a public host).
SPADE_RV_SESSION_MAX_BYTES=536870912
SPADE_RV_SESSION_MAX_SECONDS=28800
SPADE_RV_AGENT_TTL=300s
SPADE_RV_MAX_AGENTS_PER_IP=20
SPADE_RV_RATE_LOOKUPS_PER_MIN=60

# Local smoke without ACME (self-signed) — do not use in production:
# SPADE_RV_DEV_INSECURE=1
# SPADE_RV_LISTEN=:8443
# SPADE_RV_DOMAIN=localhost
